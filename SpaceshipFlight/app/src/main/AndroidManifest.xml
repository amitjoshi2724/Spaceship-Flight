<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.spaceshipflight.amitjoshi.spaceshipflight">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        <activity android:name=".MainActivity">
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".asteroidsxml">
            android:screenOrientation="landscape"
            android:theme="@android:8yle/Theme.NoTitleBar.Fullscreen"></activity>

        <service
            android:name=".RockChecker"
            android:enabled="true"
            android:exported="true" />

        <activity android:name=".Credits" />
        <activity android:name=".Instructions"></activity>
    </application>

</manifest>